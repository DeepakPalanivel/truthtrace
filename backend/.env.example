# TruthTrace Backend — Environment Variables
# Copy to .env and fill in your keys

PORT=5000
NODE_ENV=development
DB_DIR=./database
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── AI for claim extraction + evidence analysis ──────────────────────────────
# Add ONE of these to enable AI-powered investigation
# Without AI: heuristic fallback (still functional, Wikipedia search works)

# OpenAI (gpt-4o-mini) — https://platform.openai.com
# OPENAI_API_KEY=sk-...

# Groq (llama3, free tier) — https://console.groq.com
# GROQ_API_KEY=gsk_...

# ── Search APIs ───────────────────────────────────────────────────────────────
# Wikipedia is used automatically (free, no key needed)
# Add one of these for stronger evidence retrieval:

# Tavily — purpose-built for AI fact-checking, free 1000 req/mo
# https://tavily.com
# TAVILY_API_KEY=tvly-...

# Serper — Google search results, free 2500 req
# https://serper.dev
# SERPER_API_KEY=...
